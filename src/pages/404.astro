---
import SiteHeader from '../components/SiteHeader.astro';
import { RESUME } from '../content/index.ts';
import { homePath } from '../routes.ts';
import { OFFERS_PUBLISHED, SITE } from '../site.ts';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/app.css';

// A 404 has no locale — the URL that produced it told us nothing. So it says
// its piece twice, briefly, and offers the way back in both languages; French
// first, as at the root of the site (ADR 15). It wears the French header, menu
// and booking button included, and offers four ways back in rather than a
// dead end (ADR 28). While the catalogue is hidden, the field study is the
// whole site (ADR 35), and the home page, which serves it, the one way back.
const title = 'Page introuvable · Page not found';
const t = RESUME.fr;
const home = homePath('fr');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE.author}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/figtree-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <SiteHeader t={t} />
    <main id="main" class="notfound container">
      <p class="kicker">404</p>
      <h1 class="notfound__title">Rien ici</h1>
      <p class="notfound__lead">
        Cette adresse ne pointe vers aucune page. Elle a peut-être changé, ou n'a jamais existé.
      </p>
      <p class="notfound__lead" lang="en">
        This address does not point at a page. It may have moved, or never existed.
      </p>
      <div class="notfound__actions">
        <a class="btn btn-primary" href={home}>Revenir à l'accueil</a>
        {
          OFFERS_PUBLISHED && (
            <>
              <a class="btn btn-secondary" href={`${home}#workshops`}>
                Voir les ateliers
              </a>
              <a class="btn btn-secondary" href={`${home}#offers`}>
                Voir les offres et les prix
              </a>
              <a class="btn btn-secondary" href={homePath('en')} lang="en">
                Back to the home page
              </a>
            </>
          )
        }
      </div>
    </main>
  </body>
</html>
