---
import { homePath } from '../routes.ts';
import { SITE } from '../site.ts';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/app.css';

// A 404 has no locale — the URL that produced it told us nothing. So it says
// its piece twice, briefly, and offers the way back in both languages; French
// first, as at the root of the site (ADR 15).
const title = 'Page introuvable · Page not found';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE.author}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/spectral-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <main id="main" class="notfound container">
      <p class="kicker">404</p>
      <h1 class="notfound__title">Rien ici</h1>
      <p class="notfound__lead">
        Cette adresse ne pointe vers aucune page. Elle a peut-être changé, ou n'a jamais existé.
      </p>
      <p class="notfound__lead" lang="en">
        This address does not point at a page. It may have moved, or never existed.
      </p>
      <div class="notfound__actions">
        <a class="btn btn-primary" href={homePath('fr')}>Revenir à l'accueil</a>
        <a class="btn btn-secondary" href={homePath('en')} lang="en">Back to the home page</a>
      </div>
    </main>
  </body>
</html>
