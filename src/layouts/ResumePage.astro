---
import { getImage } from 'astro:assets';
import AuditCall from '../components/AuditCall.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import OffersSection from '../components/OffersSection.astro';
import ProblemSection from '../components/ProblemSection.astro';
import ReferencesSection from '../components/ReferencesSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { RESUME } from '../content/index.ts';
import { portrait } from '../lib/portrait.ts';
import { pageGraph } from '../lib/structured-data.ts';
import type { Route } from '../routes.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  route: Route;
}

const { route } = Astro.props;
const { locale } = route;
const t = RESUME[locale];

/* The Person's image: the portrait at the largest size the hero serves. */
const image = portrait && (await getImage({ src: portrait, width: 580, height: 580 }));
---

<BaseLayout
  route={route}
  title={t.meta.title}
  description={t.meta.description}
  ogType="profile"
  structuredData={pageGraph(route, { portrait: image?.src })}
>
  <SiteHeader route={route} t={t} />
  <main id="main">
    <Hero t={t} home={route.path} />
    {/* Problem → invitation → offer → proof → contact, with the person. */}
    <ProblemSection locale={locale} t={t} />
    <AuditCall locale={locale} t={t} />
    <OffersSection locale={locale} t={t} />
    <ReferencesSection t={t} />
    <ContactSection locale={locale} t={t} />
  </main>
  <SiteFooter t={t} locale={locale} />
</BaseLayout>
