---
import AboutSection from '../components/AboutSection.astro';
import AuditCall from '../components/AuditCall.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import OffersSection from '../components/OffersSection.astro';
import ProblemSection from '../components/ProblemSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WorkSection from '../components/WorkSection.astro';
import { RESUME } from '../content/index.ts';
import { profilePage } from '../lib/structured-data.ts';
import type { Route } from '../routes.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  route: Route;
}

const { route } = Astro.props;
const { locale } = route;
const t = RESUME[locale];
---

<BaseLayout
  route={route}
  title={t.meta.title}
  description={t.meta.description}
  ogType="profile"
  structuredData={profilePage(route, t.meta.title, t.meta.description)}
>
  <SiteHeader route={route} t={t} />
  <main id="main">
    <Hero t={t} home={route.path} />
    {/* Problem → invitation → offer → proof → person → contact. */}
    <ProblemSection locale={locale} t={t} num="01" />
    <AuditCall locale={locale} t={t} />
    <OffersSection locale={locale} t={t} num="02" />
    <WorkSection t={t} num="03" />
    <AboutSection t={t} num="04" />
    <ContactSection locale={locale} t={t} />
  </main>
  <SiteFooter t={t} locale={locale} />
</BaseLayout>
