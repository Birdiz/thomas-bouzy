---
import AboutSection from '../components/AboutSection.astro';
import ConceptsGrid from '../components/ConceptsGrid.astro';
import ContactSection from '../components/ContactSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import Hero from '../components/Hero.astro';
import PositionSection from '../components/PositionSection.astro';
import ProblemSection from '../components/ProblemSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WorkSection from '../components/WorkSection.astro';
import { RESUME } from '../content/index.ts';
import type { Locale } from '../site.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = RESUME[locale];
---

<BaseLayout locale={locale}>
  <SiteHeader locale={locale} t={t} />
  <main id="main">
    <Hero locale={locale} t={t} />
    <ConceptsGrid t={t} />
    <ProblemSection t={t} num="01" />
    <WorkSection t={t} num="02" />
    <PositionSection t={t} num="03" />
    <ExperienceSection t={t} num="04" />
    <AboutSection t={t} num="05" />
    <ContactSection locale={locale} t={t} />
  </main>
  <SiteFooter t={t} />
</BaseLayout>
