---
import Breadcrumb from '../components/Breadcrumb.astro';
import OfferRow from '../components/OfferRow.astro';
import BookingSection from '../components/offer/BookingSection.astro';
import OfferSheet from '../components/offer/OfferSheet.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { RESUME } from '../content/index.ts';
import { OFFER_IDS, OFFERS } from '../content/offers.ts';
import { pageGraph } from '../lib/structured-data.ts';
import { linkTo, type Route } from '../routes.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  route: Route;
}

const { route } = Astro.props;
const { locale } = route;
const t = RESUME[locale];
const page = t.publicSectorPage;
if (!page) throw new Error(`${route.path}: no ${locale} content for the public-sector page`);

/* The Offers a public buyer can order, from the Segments in offers.ts. */
const offers = OFFER_IDS.filter((id) => OFFERS[id].segments.includes('public-sector')).map(
  (id) => ({ id, ...t.offers[id], href: linkTo(id, locale).href }),
);
---

<BaseLayout
  route={route}
  title={page.meta.title}
  description={page.meta.description}
  ogType="website"
  structuredData={pageGraph(route)}
>
  <SiteHeader route={route} t={t} />
  <main id="main" class="offer">
    <header class="offer__head container">
      <Breadcrumb route={route} t={t} />
      <h1 class="offer__name">{page.title}</h1>
      <p class="offer__plain">{page.plain}</p>
    </header>

    <div class="offer__split container">
      {/* What public purchasing asks of a provider, as a sheet a buyer checks
          beside the Offers (ADR 33). */}
      <OfferSheet
        label={page.kicker}
        points={page.points}
        cta={page.book.cta}
        orWrite={page.book.orWrite}
      />

      <div class="offer__main">
        {/* What a buyer can order first, then the proof: the proof answers
            "can he?", once the reader knows what they would order (ADR 33). */}
        <section aria-labelledby="public-offers">
          <h2 class="offer__heading" id="public-offers">{page.offers}</h2>
          <ul class="offer__rows">
            {
              offers.map((offer) => (
                <OfferRow
                  id={offer.id}
                  name={offer.name}
                  plain={offer.plain}
                  href={offer.href}
                  more={page.offerLink}
                />
              ))
            }
          </ul>
        </section>

        <section class="offer__proof" aria-labelledby="public-proof">
          <h2 class="offer__heading" id="public-proof">{page.proof.heading}</h2>
          <ul>
            {
              page.proof.items.map((item) => (
                <li>
                  {/* The figure its text already holds, set large: the proof
                      reads at a glance. Hidden from a screen reader, which
                      reads it in the sentence. */}
                  <p class="offer__figure" aria-hidden="true">
                    {item.figure}
                  </p>
                  <h3 class="offer__card-title">{item.title}</h3>
                  <p class="offers__plain">{item.text}</p>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>

    <BookingSection labels={page.book} locale={locale} who={t.offerPage.who} />
  </main>
  <SiteFooter t={t} locale={locale} />
</BaseLayout>
