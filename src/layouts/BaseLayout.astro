---
import { RESUME } from '../content/index.ts';
import { ogCard, ogImageAlt } from '../lib/og.ts';
import { alternatesOf, defaultAlternateOf, type Route } from '../routes.ts';
import { absoluteUrl, CONTACT, LOCALE_TAG, type Locale, SITE } from '../site.ts';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/app.css';

interface Props {
  route: Route;
  title: string;
  description: string;
  /** `profile` for the page about the person, `website` for everything else. */
  ogType: 'profile' | 'website';
  /** JSON-LD for this page. Never carries the phone number — see docs/adr/0005. */
  structuredData: Record<string, unknown>;
}

const { route, title, description, ogType, structuredData } = Astro.props;
const { locale } = route;
const t = RESUME[locale];

const canonical = absoluteUrl(route.path);
/* The page's own card, not the home page's: see src/lib/og.ts. */
const og = ogCard(route);

/* Only between versions of this page that exist: see src/routes.ts. */
const alternates = alternatesOf(route.page);
const xDefault = defaultAlternateOf(route.page);

/** Open Graph wants the underscored form, not the BCP 47 tag. */
const OG_LOCALE: Record<Locale, string> = { en: 'en_GB', fr: 'fr_FR' };
---

<!doctype html>
<html lang={LOCALE_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    {
      /* A temporary hostname must not be indexed — see SITE.indexable. The
         header served alongside this (scripts/serve-dist.mjs) says the same
         thing to crawlers that never parse the HTML. */
      !SITE.indexable && <meta name="robots" content="noindex, nofollow" />
    }

    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={LOCALE_TAG[alternate.locale]}
          href={absoluteUrl(alternate.path)}
        />
      ))
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.path)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0e1418" />

    {/* Consolidates the profile with the sameAs in the JSON-LD, for anything reading rel=me. */}
    <link rel="me" href={CONTACT.linkedin} />

    <meta property="og:type" content={ogType} />
    {
      ogType === 'profile' && (
        <>
          <meta property="profile:first_name" content="Thomas" />
          <meta property="profile:last_name" content="Bouzy" />
        </>
      )
    }
    <meta property="og:site_name" content={SITE.author} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      alternates
        .filter((alternate) => alternate.locale !== locale)
        .map((alternate) => (
          <meta property="og:locale:alternate" content={OG_LOCALE[alternate.locale]} />
        ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(og.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt(og)} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- The h1 and every heading are Figtree 600: it is on the LCP path. -->
    <link
      rel="preload"
      href="/fonts/figtree-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {/* Without cross-document view transitions (Firefox), a page reached from
        this site still gets the arriving half of the change (docs/adr/0023).
        In the head, so the class is there before the first paint. */}
    <script is:inline>
      if (!('CSSViewTransitionRule' in window) && document.referrer.startsWith(location.origin + '/'))
        document.documentElement.classList.add('page-in');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <slot />
  </body>
</html>
