---
import { RESUME } from '../content/index.ts';
import {
  absoluteUrl,
  CONTACT,
  LOCALE_PATH,
  LOCALE_TAG,
  LOCALES,
  type Locale,
  SITE,
} from '../site.ts';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/app.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = RESUME[locale];

const canonical = absoluteUrl(LOCALE_PATH[locale]);
const ogImage = absoluteUrl('/og.png');

/**
 * Person schema for rich results. Deliberately carries no telephone: the number
 * is behind a click on the page, and repeating it here would hand it straight
 * back to any crawler. See docs/design-deltas.md.
 */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  jobTitle: t.hero.role,
  description: t.meta.description,
  url: canonical,
  image: ogImage,
  email: `mailto:${CONTACT.email}`,
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Grand Est',
    addressCountry: 'FR',
  },
  sameAs: [CONTACT.linkedin],
  knowsLanguage: t.languages.map((l) => l.name),
  knowsAbout: t.skills.flatMap((group) => group.items),
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Université de Reims Champagne-Ardenne',
  },
  worksFor: t.jobs[0] ? { '@type': 'Organization', name: t.jobs[0].company } : undefined,
};
---

<!doctype html>
<html lang={LOCALE_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />

    {
      LOCALES.map((other) => (
        <link
          rel="alternate"
          hreflang={LOCALE_TAG[other]}
          href={absoluteUrl(LOCALE_PATH[other])}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(LOCALE_PATH.en)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5ead8" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE.author} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- The h1 and every heading are Caprasimo: it is on the LCP path. -->
    <link
      rel="preload"
      href="/fonts/caprasimo-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <slot />
  </body>
</html>
