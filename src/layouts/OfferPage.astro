---
import BookingSection from '../components/offer/BookingSection.astro';
import Estimator from '../components/offer/Estimator.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { RESUME } from '../content/index.ts';
import { OFFERS, type OfferId } from '../content/offers.ts';
import { DAY_RATE } from '../content/prices.ts';
import { formatEuros } from '../lib/money.ts';
import { fromLine } from '../lib/offer-price.ts';
import { fillPrices } from '../lib/price-tokens.ts';
import { service } from '../lib/structured-data.ts';
import { linkTo, type Route } from '../routes.ts';
import { LOCALE_TAG, SITE } from '../site.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  route: Route;
  offer: OfferId;
}

const { route, offer } = Astro.props;
const { locale } = route;
const t = RESUME[locale];
const summary = t.offers[offer];
const page = t.offerPages[offer];
if (!page) throw new Error(`${route.path}: no ${locale} content for the ${offer} Offer`);
const labels = t.offerPage;

/* The Failure modes this Offer treats speak first, in the words the home page
   quotes them in; the page's own sentences follow. Each is written once. */
const sentences = [
  ...t.failureModes.filter((mode) => mode.offer === offer).map((mode) => mode.quote),
  ...page.sentences,
];

const achievements = OFFERS[offer].achievements.map((id) => {
  const achievement = t.achievements.find((candidate) => candidate.id === id);
  if (!achievement) throw new Error(`${offer} cites ${id}, which is not an Achievement`);
  return achievement;
});

/* "Not the right choice when" names another Offer as a link to it: the
   qualification the reader is doing is also how the pages link to each other. */
const redirects = page.notTheRightChoice.map(({ text, offer: other }) => {
  if (!other) return { before: fillPrices(text, locale) };
  const [before = '', after = ''] = text.split('{offer}');
  return {
    before: fillPrices(before, locale),
    after: fillPrices(after, locale),
    link: { ...linkTo(other, locale), name: t.offers[other].name },
  };
});

/** Sections are numbered in the order ADR 18 gives them, as on the home page. */
const num = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  route={route}
  title={page.meta.title}
  description={page.meta.description}
  ogType="website"
  structuredData={service(route, summary.name, summary.plain, SITE.serviceArea)}
>
  <SiteHeader route={route} t={t} contactHref="#book" />
  <main id="main" class="offer">
    {/* 1. The plain line: what the Offer does, before any word to learn. The
        H1 carries the words a buyer searches with; the catalogue name stays
        in the kicker. */}
    <header class="offer__head container">
      <p class="kicker">{labels.kicker} · {summary.name}</p>
      <h1 class="offer__name">{page.heading}</h1>
      <p class="offer__plain">{summary.plain}</p>
      {/* The price, in the first screen: on a phone it used to be three
          sections down (ADR 20). The line leads to the estimator. */}
      <p class="offer__glance">
        <a href="#offer-price">{fromLine(offer, locale, t)}</a>
      </p>
    </header>

    {/* 2. The Client sentences it answers, in the Client's words. */}
    <section class="offer__section container" aria-labelledby="offer-sentences">
      <h2 class="kicker offer__heading" id="offer-sentences">
        <span class="kicker__num" aria-hidden="true">{num(1)}</span>{labels.sentences}
      </h2>
      <ul class="offer__sentences">
        {sentences.map((sentence) => <li class="offer__sentence">{sentence}</li>)}
      </ul>
    </section>

    {/* 3. What is delivered, in the order it is delivered: the steps used to
        be a section of their own, and repeated this one (ADR 18). */}
    <section class="offer__section container" aria-labelledby="offer-delivered">
      <h2 class="kicker offer__heading" id="offer-delivered">
        <span class="kicker__num" aria-hidden="true">{num(2)}</span>{labels.delivered}
      </h2>
      <ol class="offer__cards offer__delivered">
        {
          page.delivered.map((item) => (
            <li class="offer__card">
              <h3 class="offer__card-title">{item.title}</h3>
              <p class="offer__card-text">{fillPrices(item.text, locale)}</p>
            </li>
          ))
        }
      </ol>
      {
        page.variant && (
          <div class="offer__variant">
            <h3 class="offer__card-title">{page.variant.title}</h3>
            <p class="offer__card-text">{page.variant.text}</p>
          </div>
        )
      }
    </section>

    {/* 4. The price, and the commercial rules this page governs. */}
    <section class="offer__section container" aria-labelledby="offer-price">
      <h2 class="kicker offer__heading" id="offer-price">
        <span class="kicker__num" aria-hidden="true">{num(3)}</span>{page.priceHeading}
      </h2>
      <Estimator offer={offer} locale={locale} labels={page.estimator} shared={labels} />
      {
        page.dayRate && (
          <p class="offer__day-rate">
            <strong>{page.dayRate.label}</strong>{' '}
            {formatEuros(DAY_RATE, locale)} {labels.excludingVat}, {fillPrices(page.dayRate.note, locale)}
          </p>
        )
      }
      {
        page.rules.length > 0 && (
          <ul class="offer__rules">
            {page.rules.map((rule) => (
              <li>{fillPrices(rule, locale)}</li>
            ))}
          </ul>
        )
      }
    </section>

    {/* 5. When it is not the right choice, and what is: the Offer's own price. */}
    <section class="offer__section container" aria-labelledby="offer-fit">
      <h2 class="kicker offer__heading" id="offer-fit">
        <span class="kicker__num" aria-hidden="true">{num(4)}</span>{labels.notTheRightChoice}
      </h2>
      <ul class="offer__fit-list">
        {
          redirects.map((line) => (
            <li>
              {line.before}
              {line.link && (
                <a
                  href={line.link.href}
                  hreflang={line.link.hreflang && LOCALE_TAG[line.link.hreflang]}
                >
                  {line.link.name}
                </a>
              )}
              {/* A link to a page that exists only in French says so. */}
              {line.link?.hreflang && ` ${t.offersSection.inFrench}`}
              {line.after}
            </li>
          ))
        }
      </ul>
    </section>

    {/* 6. The Achievements that prove it. */}
    <section class="offer__section container" aria-labelledby="offer-achievements">
      <h2 class="kicker offer__heading" id="offer-achievements">
        <span class="kicker__num" aria-hidden="true">{num(5)}</span>{labels.achievements}
      </h2>
      <ul class="offer__cards">
        {
          achievements.map((achievement) => (
            <li class="offer__card">
              <h3 class="offer__card-title">{achievement.title}</h3>
              <p class="offer__card-meta">
                {achievement.org} · {achievement.period}
              </p>
              <p class="offer__card-text">{achievement.plain}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* 7. A short FAQ. */}
    <section class="offer__section container" aria-labelledby="offer-faq">
      <h2 class="kicker offer__heading" id="offer-faq">
        <span class="kicker__num" aria-hidden="true">{num(6)}</span>{labels.faq}
      </h2>
      <div class="offer__faq">
        {
          page.faq.map((entry) => (
            <details class="offer__question">
              <summary>{entry.question}</summary>
              <p>{fillPrices(entry.answer, locale)}</p>
            </details>
          ))
        }
      </div>
    </section>

    {/* 8. The booking link. */}
    <BookingSection labels={labels.book} locale={locale} />
  </main>
  <SiteFooter t={t} locale={locale} />
</BaseLayout>
