---
import { Image } from 'astro:assets';
import Breadcrumb from '../components/Breadcrumb.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { RESUME } from '../content/index.ts';
import { portrait } from '../lib/portrait.ts';
import { pageGraph } from '../lib/structured-data.ts';
import { homePath, type Route } from '../routes.ts';
import { FIELD_STUDY } from '../site.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  route: Route;
}

const { route } = Astro.props;
const { locale } = route;
const t = RESUME[locale];
const page = t.surveyPage;
if (!page) throw new Error(`${route.path}: no ${locale} content for the survey page`);
/* While the catalogue is hidden, this page is the home page (ADR 35): no trail
   leads to it. */
const isHome = route.path === homePath(locale);
---

{/* The field study (ADR 34): one line, who asks, the questionnaire, and what
    happens to the answers. While the catalogue is hidden it is the whole site,
    at the home page's address (ADR 35), and says nothing of what Thomas does. The questionnaire is served and stored by the back office,
    a separate application; this page only renders it, its introduction
    included, which is where the study says what it is about. Without
    JavaScript the page says so and offers the address instead. */}
<BaseLayout
  route={route}
  title={page.meta.title}
  description={page.meta.description}
  ogType="website"
  structuredData={pageGraph(route)}
>
  <SiteHeader route={route} t={t} />
  <main id="main" class="offer">
    <header class="offer__head container">
      {isHome ? <p class="kicker">{page.kicker}</p> : <Breadcrumb route={route} t={t} />}
      <h1 class="offer__name">{page.title}</h1>
      <p class="offer__plain">{page.plain}</p>
      <p class="survey__byline">
        {
          portrait && (
            <Image
              src={portrait}
              alt=""
              class="washed"
              width={128}
              height={128}
              widths={[64, 128]}
              sizes="64px"
              loading="eager"
            />
          )
        }
        <span>{page.byline}</span>
      </p>
    </header>

    <section class="offer__section container" aria-label={page.form.name}>
      <div
        class="survey__app"
        data-survey
        data-api={FIELD_STUDY.apiOrigin}
        data-slug={FIELD_STUDY.slug}
        data-labels={JSON.stringify(page.form)}
      >
        <p class="survey__message survey__noscript">{page.form.noScript}</p>
      </div>
    </section>

    <section class="offer__section about-page__text container" aria-labelledby="privacy">
      <h2 id="privacy" class="offer__heading">{page.privacy.title}</h2>
      {page.privacy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>
  </main>
  <SiteFooter t={t} locale={locale} />
</BaseLayout>

<script>
  import type { SurveyFormLabels } from '../content/types.ts';
  import { mountSurvey } from '../lib/survey/form.ts';

  const root = document.querySelector<HTMLElement>('[data-survey]');
  if (root) {
    mountSurvey({
      root,
      apiOrigin: root.dataset.api ?? '',
      slug: root.dataset.slug ?? '',
      labels: JSON.parse(root.dataset.labels ?? '{}') as SurveyFormLabels,
    });
  }
</script>

<style is:global>
  /* The field study's form (ADR 34). Global, because its fields are built by
     script and carry no scope attribute. Kept small: the one route component
     ships it with every page's inline styles. */
  .survey__byline {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 52ch;
    margin: 20px 0 0;
    font-size: 15.5px;
    text-wrap: pretty;
  }
  .survey__byline img {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 999px;
    object-fit: cover;
  }
  .survey__app {
    max-width: 44rem;
    padding: clamp(16px, 4vw, 28px);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .survey__message,
  .survey__label {
    display: block;
    font-size: 17px;
    line-height: 1.5;
    margin: 0 0 12px;
    padding: 0;
  }
  .survey__step,
  .survey__optional,
  .survey__help,
  .survey__counter {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 8px;
  }
  .survey__bar {
    height: 4px;
    margin-bottom: 20px;
    background: var(--color-divider);
  }
  .survey__bar span {
    display: block;
    height: 100%;
    width: calc(var(--ratio, 0) * 100%);
    background: var(--color-accent-fill);
  }
  .survey__title {
    font-size: 26px;
    margin: 0 0 22px;
    outline: none;
  }
  .survey__intro {
    margin: 0 0 32px;
    font-size: 17px;
    line-height: 1.55;
  }
  .survey__intro-heading {
    font-size: 22px;
    margin: 0 0 12px;
  }
  .survey__intro p {
    margin: 0 0 10px;
  }
  .survey__question,
  .survey__fieldset {
    border: 0;
    margin: 0 0 26px;
    padding: 0;
  }
  .survey__error {
    color: var(--color-accent-text);
    font-size: 14px;
    margin: 6px 0 0;
  }
  .survey__error:empty {
    display: none;
  }
  .survey__scale,
  .survey__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .survey__choice {
    display: flex;
    gap: 10px;
    padding-block: 5px;
    font-size: 16px;
    line-height: 1.45;
  }
  .survey__choice input {
    flex: none;
    width: 18px;
    height: 18px;
    accent-color: var(--color-accent-fill);
  }
  .survey__reveal,
  .survey__aside {
    margin-left: 28px;
  }
  .survey__form-error,
  .survey__send-error {
    margin: 0 0 16px;
    outline: none;
  }
  .survey__app :is(textarea, select, input:not([type="checkbox"], [type="radio"])) {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 12px;
    border: 1px solid var(--color-neutral-500);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: inherit;
    font: inherit;
  }
  .survey__nav .btn-primary {
    margin-left: auto;
  }
  .survey__trap {
    position: absolute;
    left: -9999px;
  }
</style>
