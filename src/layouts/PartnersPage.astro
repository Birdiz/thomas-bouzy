---
import Breadcrumb from '../components/Breadcrumb.astro';
import OfferRow from '../components/OfferRow.astro';
import BookingSection from '../components/offer/BookingSection.astro';
import OfferSheet from '../components/offer/OfferSheet.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { RESUME } from '../content/index.ts';
import { OFFER_IDS, OFFERS } from '../content/offers.ts';
import { DAY_RATE } from '../content/prices.ts';
import { formatEuros } from '../lib/money.ts';
import { fillPrices } from '../lib/price-tokens.ts';
import { pageGraph } from '../lib/structured-data.ts';
import { linkTo, type Route } from '../routes.ts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  route: Route;
}

const { route } = Astro.props;
const { locale } = route;
const t = RESUME[locale];
const page = t.partnersPage;
if (!page) throw new Error(`${route.path}: no ${locale} content for the Partners page`);

/* The Offers a Partner can bring Thomas into, from the Segments in offers.ts. */
const offers = OFFER_IDS.filter((id) => OFFERS[id].segments.includes('partners')).map((id) => ({
  id,
  ...t.offers[id],
  href: linkTo(id, locale).href,
}));
---

<BaseLayout
  route={route}
  title={page.meta.title}
  description={page.meta.description}
  ogType="website"
  structuredData={pageGraph(route)}
>
  <SiteHeader route={route} t={t} />
  <main id="main" class="offer">
    <header class="offer__head container">
      <Breadcrumb route={route} t={t} />
      <h1 class="offer__name">{page.title}</h1>
      <p class="offer__plain">{page.plain}</p>
    </header>

    <div class="offer__split container">
      <OfferSheet
        label={page.kicker}
        points={page.points}
        cta={page.book.cta}
        orWrite={page.book.orWrite}
      >
        {/* Read from the price table, like Reinforcement's: one number, one
            place. The same number: a Partner pays what a Client pays (ADR 18).
            The figure an agency asks first, so the sheet opens on it (ADR 33). */}
        <p class="offer__rate">
          <span class="offers__plain">{page.dayRate.label}</span>
          <span class="offer__rate-figure">
            {formatEuros(DAY_RATE, locale)} <small>{t.offerPage.excludingVat}</small>
          </span>
          <span>{fillPrices(page.dayRate.note, locale)}</span>
        </p>
      </OfferSheet>

      <div class="offer__main">
        <section aria-labelledby="partners-offers">
          <h2 class="offer__heading" id="partners-offers">{page.offers}</h2>
          <ul class="offer__rows">
            {
              offers.map((offer) => (
                <OfferRow
                  id={offer.id}
                  name={offer.name}
                  plain={offer.plain}
                  href={offer.href}
                  more={page.offerLink}
                />
              ))
            }
          </ul>
        </section>

        {/* For a Referrer, who sees a client's trouble first and buys nothing:
            an accountant, an integrator (ADR 30). Addressed apart from the
            Partners, under their Offers, in the quiet voice the home page gives
            its other readers (ADR 33). */}
        <p class="offer__referrers">{page.referrers}</p>
      </div>
    </div>

    <BookingSection labels={page.book} locale={locale} who={t.offerPage.who} />
  </main>
  <SiteFooter t={t} locale={locale} />
</BaseLayout>
