---
import type { OfferId } from '../../content/offers.ts';
import { combinationFor, isMonthly, optionCombinations, PRICES } from '../../content/prices.ts';
import type { EstimatorLabels, OfferPageLabels } from '../../content/types.ts';
import { formatEuroRange, formatSpan } from '../../lib/money.ts';
import type { Locale } from '../../site.ts';

interface Props {
  offer: OfferId;
  locale: Locale;
  labels: EstimatorLabels;
  shared: OfferPageLabels;
}

const { offer, locale, labels, shared } = Astro.props;

/**
 * Every range the price table holds for this Offer, as a static table built
 * from prices.ts. It is the whole estimator for a reader without JavaScript:
 * the interaction is what they lose, never the price (ADR 17).
 */
const table = PRICES[offer];

function labelOf(dimension: string, option: string): string {
  const label = labels.dimensions[dimension]?.options[option];
  if (!label) throw new Error(`${offer}: no ${locale} label for ${dimension}=${option}`);
  return label;
}

/** What a monthly amount is made of, when it includes days at the day rate. */
function daysIncluded(days: number | undefined): string | undefined {
  if (days === undefined) return undefined;
  if (!labels.daysIncluded) throw new Error(`${offer}: no ${locale} label for the days included`);
  return labels.daysIncluded.replace('{days}', new Intl.NumberFormat(locale).format(days));
}

const rows = optionCombinations(table).map((options) => {
  const combination = combinationFor(table, options);
  if (!combination) throw new Error(`${offer}: no price for ${options.join(' × ')}`);
  return {
    key: options.join(' '),
    options: options.map((option, i) => labelOf(table.dimensions[i]?.id ?? '', option)),
    amounts: table.amounts.map((amount) => {
      const range = combination.amounts[amount];
      if (!range) throw new Error(`${offer}: ${options.join(' × ')} has no ${amount}`);
      const unit = isMonthly(amount) ? ` ${shared.perMonth}` : '';
      return {
        price: `${formatEuroRange(range, locale)}${unit} ${shared.excludingVat}`,
        detail: isMonthly(amount) ? daysIncluded(combination.daysIncluded) : undefined,
      };
    }),
    weeks: combination.weeks
      ? `${formatSpan(combination.weeks)} ${
          combination.weeks.max > 1 ? shared.weekMany : shared.weekOne
        }`
      : undefined,
  };
});

const id = `estimator-${offer}`;
const disclaimerId = `${id}-disclaimer`;
const resultLabels = [
  ...table.amounts.map((amount) => labels.amounts[amount]),
  ...(table.duration ? [labels.duration] : []),
];
---

{/*
  Progressive enhancement (ADR 17). The server renders the table; the script
  below, when it runs, reveals one labelled slider per dimension and a result
  region, and hides the table it now stands in for. It reads nothing but this
  markup: each row carries its options in `data-options`, and its cells are
  already formatted, so the result is a copy of a row the table holds and the
  two cannot disagree. No Offer has code of its own: the dimensions come from
  the price table, and a new Offer gets its sliders by declaring them there.
*/}
<div class="estimator" data-estimator>
  <p class="estimator__disclaimer" id={disclaimerId}>{shared.disclaimer}</p>

  <div class="estimator__live" data-estimator-live hidden>
    <div class="estimator__sliders">
      {
        table.dimensions.map((dimension) => (
          <div class="estimator__slider">
            <label for={`${id}-${dimension.id}`}>
              {labels.dimensions[dimension.id]?.label}
              <span class="estimator__choice" data-choice aria-hidden="true" />
            </label>
            <input
              type="range"
              id={`${id}-${dimension.id}`}
              min="0"
              max={dimension.options.length - 1}
              step="1"
              value="0"
              data-options={dimension.options.join(' ')}
            />
          </div>
        ))
      }
    </div>
    {/* Announced politely each time a slider settles on a new option. */}
    <div class="estimator__result" role="status">
      <dl class="estimator__figures">
        {
          resultLabels.map((label) => (
            <div class="estimator__figure">
              <dt>{label}</dt>
              <dd data-figure />
            </div>
          ))
        }
      </dl>
      <p class="visually-hidden">{shared.disclaimer}</p>
    </div>
  </div>

  <div
    class="estimator__table-wrap"
    data-estimator-table
    role="region"
    aria-label={shared.tableCaption}
    tabindex="0"
  >
    <table class="table estimator__table" aria-describedby={disclaimerId}>
      <caption class="visually-hidden">{shared.tableCaption}</caption>
      <thead>
        <tr>
          {table.dimensions.map((dimension) => <th scope="col">{labels.dimensions[dimension.id]?.label}</th>)}
          {table.amounts.map((amount) => <th scope="col">{labels.amounts[amount]}</th>)}
          {table.duration && <th scope="col">{labels.duration}</th>}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr data-options={row.key}>
              {row.options.map((option) => (
                <td>{option}</td>
              ))}
              {row.amounts.map((amount) => (
                <td class="estimator__amount">
                  {amount.price}
                  {amount.detail && <span class="estimator__detail">{amount.detail}</span>}
                </td>
              ))}
              {row.weeks && <td>{row.weeks}</td>}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  for (const root of document.querySelectorAll<HTMLElement>('[data-estimator]')) {
    const sliders = [...root.querySelectorAll<HTMLInputElement>('input[type=range]')];
    const choices = root.querySelectorAll('[data-choice]');
    const figures = root.querySelectorAll('[data-figure]');

    const update = () => {
      const key = sliders
        .map((slider) => slider.dataset.options?.split(' ')[slider.valueAsNumber])
        .join(' ');
      const row = root.querySelector<HTMLTableRowElement>(`tr[data-options="${key}"]`);
      if (!row) return;
      const cells = [...row.cells];
      sliders.forEach((slider, i) => {
        const text = cells[i]?.textContent ?? '';
        slider.setAttribute('aria-valuetext', text);
        const choice = choices[i];
        if (choice) choice.textContent = text;
      });
      // A figure is a copy of its cell, detail line included. One that changes
      // comes up into place, so the reader sees which figure the slider moved.
      figures.forEach((figure, i) => {
        const before = figure.textContent;
        figure.replaceChildren(...(cells[sliders.length + i]?.cloneNode(true).childNodes ?? []));
        if (before && before !== figure.textContent && !still.matches) {
          figure.animate([{ opacity: 0.3, transform: 'translateY(6px)' }, {}], {
            duration: 220,
            easing: 'ease-out',
          });
        }
      });
    };

    for (const slider of sliders) slider.addEventListener('input', update);
    update();
    root.querySelector<HTMLElement>('[data-estimator-live]')?.removeAttribute('hidden');
    root.querySelector<HTMLElement>('[data-estimator-table]')?.setAttribute('hidden', '');
  }
</script>
