---
import type { ResumeContent } from '../content/index.ts';
import { OFFER_IDS } from '../content/offers.ts';
import { homePath, linkTo, type PageLink } from '../routes.ts';
import { CONTACT, LEGAL, LOCALE_TAG, type Locale, OFFERS_PUBLISHED, SITE } from '../site.ts';

interface Props {
  t: ResumeContent;
  locale: Locale;
}

const { t, locale } = Astro.props;

/* Every page from every page: the Workshops where this locale has them, every
   Offer, the Partners and public-sector pages, and About (ADR 28). The header
   reaches the home page's sections, and an Offer page was otherwise a dead end.
   While the catalogue is hidden, the field study is the whole site (ADR 35):
   the footer keeps the name, the address the privacy notice points to, and
   the legal notice, and says nothing of what Thomas does. */
const pages: (PageLink & { name: string })[] = OFFERS_PUBLISHED
  ? [
      ...(t.workshops ? [{ href: `${homePath(locale)}#workshops`, name: t.workshops.nav }] : []),
      ...OFFER_IDS.map((id) => ({ ...linkTo(id, locale), name: t.offers[id].name })),
      { ...linkTo('partners', locale), name: t.nav.partners },
      { ...linkTo('public-sector', locale), name: t.nav.publicSector },
      { ...linkTo('about', locale), name: t.nav.about },
    ]
  : [];

/**
 * The legal block only renders once LEGAL is filled in — see site.ts. A notice
 * missing its SIRET is not a lighter notice, it is an unfinished one, and the
 * footer reads better carrying only what it can state.
 *
 * No copyright year: a year baked at build time is a date that goes stale on a
 * page nobody rebuilds, which is the exact signal this footer exists to avoid.
 */
const legal = LEGAL.isComplete ? LEGAL : null;
---

<footer class="site-footer" aria-label={t.footer.landmark}>
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      <span class="site-footer__name">{SITE.author}</span>
      {
        OFFERS_PUBLISHED && (
          <>
            <span class="site-footer__role">{t.footer.role}</span>
            <span class="site-footer__region">{SITE.region}</span>
          </>
        )
      }
    </div>

    {
      pages.length > 0 && (
        <nav class="site-footer__links" aria-label={t.footer.pages}>
          {pages.map((page) => (
            <a href={page.href} hreflang={page.hreflang && LOCALE_TAG[page.hreflang]}>
              {page.name}
              {page.hreflang && ` ${t.offersSection.inFrench}`}
            </a>
          ))}
        </nav>
      )
    }

    <nav class="site-footer__links" aria-label={t.contact.kicker}>
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      {
        OFFERS_PUBLISHED && (
          <>
            <a href={CONTACT.github} target="_blank" rel="noopener">
              GitHub
            </a>
            <a href={CONTACT.linkedin} target="_blank" rel="noopener">
              LinkedIn
            </a>
          </>
        )
      }
    </nav>

    {
      legal && (
        <div class="site-footer__legal">
          <h2 class="site-footer__legal-heading">{t.footer.legalHeading}</h2>
          <p>
            {legal.businessName} — {legal.legalForm}
            <br />
            {legal.address}
            <br />
            {t.footer.siretLabel} {legal.siret}
            {legal.vat && (
              <>
                {' · '}
                {t.footer.vatLabel} {legal.vat}
              </>
            )}
          </p>
          <p>
            {t.footer.hostedBy}{' '}
            <a href={legal.host.url} target="_blank" rel="noopener">
              {legal.host.name}
            </a>
            {legal.host.address && `, ${legal.host.address}`}
          </p>
        </div>
      )
    }
  </div>
</footer>
