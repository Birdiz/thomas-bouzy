---
import type { ResumeContent } from '../content/index.ts';
import { alternatesOf, homePath, type Route } from '../routes.ts';
import { LOCALE_ENDONYM, LOCALE_LABEL, LOCALE_TAG, SITE } from '../site.ts';

interface Props {
  route: Route;
  t: ResumeContent;
  /** Where the header's call to action goes. The home page's contact section by default. */
  contactHref?: string;
}

const { route, t, contactHref } = Astro.props;
const { locale } = route;
const home = homePath(locale);

/* The same page in each locale it exists in. A page in one locale has no
   switch at all: a link to the other language's home page would drop the
   reader somewhere they did not ask to go. */
const versions = alternatesOf(route.page);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={`${home}#top`}>
      <span class="site-header__dot" aria-hidden="true"></span>
      <span>{SITE.author}</span>
    </a>

    <nav class="site-nav" aria-label={t.a11y.mainNavigation}>
      {/* Spelled from the home page, so they work from every page. */}
      <a href={`${home}#offers`}>{t.nav.offers}</a>
      <a href={`${home}#work`}>{t.nav.work}</a>
      <a href={`${home}#about`}>{t.nav.about}</a>
    </nav>

    <div class="site-header__actions">
      {
        versions.length > 0 && (
          <nav class="lang-switch" aria-label={t.a11y.languageSwitcher}>
            {versions.map((version) => (
              <a
                href={version.path}
                hreflang={LOCALE_TAG[version.locale]}
                lang={LOCALE_TAG[version.locale]}
                aria-label={LOCALE_ENDONYM[version.locale]}
                aria-current={version.locale === locale ? 'true' : undefined}
              >
                {LOCALE_LABEL[version.locale]}
              </a>
            ))}
          </nav>
        )
      }
      <a class="btn btn-primary" href={contactHref ?? `${home}#contact`}>{t.nav.contact}</a>
    </div>
  </div>
</header>
