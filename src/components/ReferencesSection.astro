---
import type { ResumeContent } from '../content/index.ts';
import { REFERENCES } from '../content/offers.ts';
import ReferenceRow from './ReferenceRow.astro';

interface Props {
  t: ResumeContent;
}

const { t } = Astro.props;

const references = REFERENCES.map((reference) => ({
  id: reference.id,
  ...t.references[reference.id],
  cases: reference.achievements.map((id) => {
    const achievement = t.achievements.find((a) => a.id === id);
    if (!achievement) throw new Error(`Reference ${reference.id}: no achievement ${id}`);
    return achievement;
  }),
}));

/**
 * The first References are read; the rest wait one click away (ADR 31): seven
 * rows of the same weight put a product of his own level with ArcelorMittal,
 * and the hero already carries the two that matter most. The four shown are
 * the three engagements and the one audit of someone else's code, the Entry
 * offer's proof (ADR 30).
 */
const SHOWN = 4;
const shown = references.slice(0, SHOWN);
const folded = references.slice(SHOWN);
const row = ({ id, cases, ...reference }: (typeof references)[number]) => ({
  id,
  cases,
  reference,
});
---

<section id="work" class="work container">
  <p class="kicker">{t.work.kicker}</p>
  <h2 class="section-title">{t.work.title}</h2>
  <p class="work__intro">{t.work.intro}</p>

  <div class="work__list">
    {shown.map((r) => <ReferenceRow {...row(r)} t={t} />)}
  </div>

  {
    folded.length > 0 && (
      <details class="work__more">
        <summary>{t.work.more.replace('{count}', String(folded.length))}</summary>
        <div class="work__list">
          {folded.map((r) => <ReferenceRow {...row(r)} t={t} />)}
        </div>
      </details>
    )
  }
</section>
