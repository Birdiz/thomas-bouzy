---
import { Image } from 'astro:assets';
import type { ResumeContent } from '../content/index.ts';
import { portrait } from '../lib/portrait.ts';
import { pathOf } from '../routes.ts';
import { CONTACT, type Locale, OFFERS_PUBLISHED, SITE } from '../site.ts';
import Ridge from './Ridge.astro';

interface Props {
  t: ResumeContent;
  /** The home page's own path, so the button's anchor is spelled like the header's. */
  home: string;
  locale: Locale;
}

const { t, home, locale } = Astro.props;

interface Button {
  href: string;
  label: string;
  /** The booking page opens in a tab of its own; the site's own links do not. */
  external?: boolean;
}

const book: Button = { href: CONTACT.booking, label: t.hero.ctaBook, external: true };
/* While the catalogue is hidden (ADR 34), the field study is the page's ask
   where it exists in this locale: its button comes first, and the call second.
   Elsewhere the call stays first and the second button leads to the proof.
   With the catalogue, the call comes first and the second button leads to the
   way in: the Workshops where this locale has them, the Offers otherwise
   (ADR 27). */
const study = OFFERS_PUBLISHED ? undefined : t.fieldStudy.survey;
const studyPath = study && pathOf('survey', locale);
const [primary, secondary]: [Button, Button] = OFFERS_PUBLISHED
  ? [book, { href: `${home}#${t.workshops ? 'workshops' : 'offers'}`, label: t.hero.ctaSecondary }]
  : study && studyPath
    ? [{ href: studyPath, label: study.cta }, book]
    : [book, { href: `${home}#work`, label: t.fieldStudy.seeWork }];
const blurb = OFFERS_PUBLISHED ? t.hero.blurb : t.fieldStudy.blurb;
const target = (button: Button) => (button.external ? { target: '_blank', rel: 'noopener' } : {});
---

<section id="top" class="hero">
  <Ridge />
  <div class="hero__inner container">

    <div class="hero__grid">
      <div class="hero__intro">
        {/* The job title Thomas says when he introduces himself, above the
            promise (ADR 27), and where he works (ADR 28): a reader who met
            him finds both on the first screen. */}
        <p class="kicker hero__kicker">
          <span class="hero__role">{t.hero.role}</span>
          <span aria-hidden="true">·</span>
          <span>{t.hero.region}</span>
        </p>
        {/* The name, then the promise, in one H1. The name is for search
            engines and screen readers only: the header already shows it, and
            twice in the first screen is once too many. */}
        <h1 class="hero__name">
          <span class="visually-hidden">{SITE.author} — </span>
          <span class="hero__promise">{t.hero.title}</span>
        </h1>
        <p class="hero__blurb">{blurb}</p>

        {/* One primary action from the first screen, and one secondary way
            in for the reader who wants to look first. No years badge, no CV. */}
        <div class="hero__ctas">
          <a class="btn btn-primary" href={primary.href} {...target(primary)}>{primary.label}</a>
          <a class="btn btn-secondary" href={secondary.href} {...target(secondary)}>
            {secondary.label}
          </a>
        </div>

        {/* The proof under the buttons, where most of the reading happens
            (ADR 28): the facts were four screens down, in the References. */}
        <p class="hero__proof">{t.hero.proof}</p>
      </div>

      <div class="hero__portrait">
        {
          portrait ? (
            <Image
              src={portrait}
              alt={t.a11y.portraitAlt}
              class="washed"
              width={580}
              height={580}
              widths={[300, 440, 580]}
              sizes="(max-width: 640px) 150px, (max-width: 1023px) 220px, 290px"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <p class="hero__portrait-fallback">src/assets/portrait.jpg</p>
          )
        }
      </div>
    </div>
  </div>
</section>
