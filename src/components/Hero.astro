---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ResumeContent } from '../content/index.ts';
import { publicAssetExists } from '../lib/public-assets.ts';
import { CV, type Locale, SITE } from '../site.ts';

interface Props {
  locale: Locale;
  t: ResumeContent;
}

const { locale, t } = Astro.props;

/**
 * The design's <image-slot> was an empty placeholder. Drop a file at
 * src/assets/portrait.{jpg,jpeg,png,webp,avif} and it is picked up, optimised
 * and served responsively; until then the hero shows a labelled placeholder
 * instead of an empty circle.
 */
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

const cvHref = CV.path(locale);
const hasCv = publicAssetExists(cvHref);
---

<section id="top" class="hero">
  <div class="hero__inner container">
    <div class="hero__blob" aria-hidden="true"></div>

    <div class="hero__grid">
      <div class="hero__intro">
        <p class="hero__availability">
          <span class="hero__pulse" aria-hidden="true"></span>
          {t.hero.availability}
        </p>

        <h1 class="hero__name">{SITE.author}</h1>
        <p class="hero__role">{t.hero.role}</p>
        <p class="hero__blurb">{t.hero.blurb}</p>

        {/* The four stack badges left with the rest of the chips: the stack is
            carried by the dated Track record chips alone now. The years tag is
            not a stack claim, so it stays. */}
        <ul class="hero__badges">
          <li><span class="tag tag-accent">{t.hero.yearsCount} {t.hero.yearsLabel}</span></li>
        </ul>

        <div class="hero__ctas">
          <a class="btn btn-primary" href="#work">{t.hero.ctaWork}</a>
          {
            hasCv && (
              <a class="btn btn-secondary" href={cvHref} download={CV.downloadName(locale)}>
                <span aria-hidden="true">↓</span> {t.hero.ctaPdf}
              </a>
            )
          }
        </div>
      </div>

      <div class="hero__portrait">
        {
          portrait ? (
            <Image
              src={portrait}
              alt={t.a11y.portraitAlt}
              class="washed"
              width={580}
              height={580}
              widths={[300, 440, 580]}
              sizes="(max-width: 640px) 150px, (max-width: 1023px) 220px, 290px"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <p class="hero__portrait-fallback">src/assets/portrait.jpg</p>
          )
        }
      </div>
    </div>
  </div>
</section>
