---
import { Image } from 'astro:assets';
import type { ResumeContent } from '../content/index.ts';
import { portrait } from '../lib/portrait.ts';
import { CONTACT, SITE } from '../site.ts';
import Ridge from './Ridge.astro';

interface Props {
  t: ResumeContent;
  /** The home page's own path, so the button's anchor is spelled like the header's. */
  home: string;
}

const { t, home } = Astro.props;
---

<section id="top" class="hero">
  <Ridge />
  <div class="hero__inner container">

    <div class="hero__grid">
      <div class="hero__intro">
        {/* The name, then the promise, in one H1. The name is for search
            engines and screen readers only: the header already shows it, and
            twice in the first screen is once too many. */}
        <h1 class="hero__name">
          <span class="visually-hidden">{SITE.author} — </span>
          <span class="hero__promise">
            {t.hero.title.map((line) => <span class="hero__promise-line">{line} </span>)}
          </span>
        </h1>
        <p class="hero__blurb">{t.hero.blurb}</p>

        {/* The call is the page's one primary action, from the first screen.
            The Offers are the secondary way in, for the reader who wants to
            look before talking. No job title, no years badge, no CV. */}
        <div class="hero__ctas">
          <a class="btn btn-primary" href={CONTACT.booking} target="_blank" rel="noopener">
            {t.hero.ctaBook}
          </a>
          <a class="btn btn-secondary" href={`${home}#offers`}>{t.hero.ctaOffers}</a>
        </div>
      </div>

      <div class="hero__portrait">
        {
          portrait ? (
            <Image
              src={portrait}
              alt={t.a11y.portraitAlt}
              class="washed"
              width={580}
              height={580}
              widths={[300, 440, 580]}
              sizes="(max-width: 640px) 150px, (max-width: 1023px) 220px, 290px"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <p class="hero__portrait-fallback">src/assets/portrait.jpg</p>
          )
        }
      </div>
    </div>
  </div>
</section>
