---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ResumeContent } from '../content/index.ts';
import { SITE } from '../site.ts';

interface Props {
  t: ResumeContent;
}

const { t } = Astro.props;

/**
 * The design's <image-slot> was an empty placeholder. Drop a file at
 * src/assets/portrait.{jpg,jpeg,png,webp,avif} and it is picked up, optimised
 * and served responsively; until then the hero shows a labelled placeholder
 * instead of an empty circle.
 */
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;
---

<section id="top" class="hero">
  <div class="hero__inner container">
    <div class="hero__blob" aria-hidden="true"></div>

    <div class="hero__grid">
      <div class="hero__intro">
        <p class="hero__availability">
          <span class="hero__pulse" aria-hidden="true"></span>
          {t.hero.availability}
        </p>

        <h1 class="hero__name">{SITE.author}</h1>
        <p class="hero__blurb">{t.hero.blurb}</p>

        {/* One button, and it points at the work.
            The job-title line, the "12 years" badge and the CV download all
            left with chantier A: a title and a years count answer a hiring
            question this page does not ask, and a CV button in the first
            viewport offered the salaried route as an equal alternative to the
            work itself. The PDF is an end-of-journey object — it is reached
            once, from the About section. */}
        <div class="hero__ctas">
          <a class="btn btn-primary" href="#work">{t.hero.ctaWork}</a>
        </div>
      </div>

      <div class="hero__portrait">
        {
          portrait ? (
            <Image
              src={portrait}
              alt={t.a11y.portraitAlt}
              class="washed"
              width={580}
              height={580}
              widths={[300, 440, 580]}
              sizes="(max-width: 640px) 150px, (max-width: 1023px) 220px, 290px"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <p class="hero__portrait-fallback">src/assets/portrait.jpg</p>
          )
        }
      </div>
    </div>
  </div>
</section>
