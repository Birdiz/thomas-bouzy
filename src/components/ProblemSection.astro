---
import type { ResumeContent } from '../content/index.ts';
import { linkTo } from '../routes.ts';
import { LOCALE_TAG, type Locale } from '../site.ts';

interface Props {
  locale: Locale;
  t: ResumeContent;
  num: string;
}

const { locale, t, num } = Astro.props;
---

<section id="problem" class="problem container">
  <p class="kicker"><span class="kicker__num">{num}</span>{t.problem.kicker}</p>
  <h2 class="section-title problem__title">{t.problem.title}</h2>

  {/* No prose before the sentences any more: the paragraphs that stood here
      argued with a peer, under a hero written for a business owner (ADR 18). */}
  <div>
      <ul class="problem__modes">
        {
          t.failureModes.map((mode, i) => {
            const target = linkTo(mode.offer, locale);
            return (
              <li class="problem__mode">
                <span class="problem__mode-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  {/* The client's sentence is the heading, and it is the way
                      in: it links to the Offer that treats it. A reader who
                      recognises his own words has qualified himself, and now
                      has somewhere to go — see docs/adr/0012 and 0014. */}
                  <h3 class="problem__mode-quote">
                    <a
                      href={target.href}
                      hreflang={target.hreflang && LOCALE_TAG[target.hreflang]}
                    >
                      {mode.quote}
                      <span class="problem__mode-offer">
                        {t.offers[mode.offer].name}
                        {target.hreflang && ` ${t.offersSection.inFrench}`}
                        <span aria-hidden="true"> →</span>
                      </span>
                    </a>
                  </h3>
                  <p class="problem__mode-text">{mode.text}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
  </div>
</section>
