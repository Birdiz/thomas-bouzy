---
import type { ResumeContent } from '../content/index.ts';
import { linkTo } from '../routes.ts';
import { LOCALE_TAG, type Locale } from '../site.ts';

interface Props {
  locale: Locale;
  t: ResumeContent;
}

const { locale, t } = Astro.props;
---

{/* Every Client sentence on the page at once, each the way to the Offer that
    treats it (ADR 28). They used to pass one at a time in a carousel, which
    showed one in five and was read as invented testimonials. */}
<section id="problem" class="problem container">
  <div class="problem__head">
    <p class="kicker">{t.problem.kicker}</p>
    <h2 class="section-title problem__title">{t.problem.title}</h2>
    <p class="hero__blurb">{t.problem.lead}</p>
  </div>

  <div class="problem__body">
    <p class="problem__question">{t.problem.question}</p>
    <ul class="problem__modes" data-reveal>
      {
        t.failureModes.map((mode, i) => {
          const target = linkTo(mode.offer, locale);
          return (
            <li class="problem__mode">
              <span class="problem__mode-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {/* The client's sentence is the heading, and it is the way in:
                  it links to the Offer that treats it. A reader who
                  recognises their own words has qualified themselves, and now
                  has somewhere to go. */}
              <h3 class="problem__mode-quote">
                <a href={target.href} hreflang={target.hreflang && LOCALE_TAG[target.hreflang]}>
                  {mode.quote}
                  <span class="problem__mode-offer">
                    {t.offers[mode.offer].name}
                    {target.hreflang && ` ${t.offersSection.inFrench}`}
                    <span aria-hidden="true"> →</span>
                  </span>
                </a>
              </h3>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  // Each sentence comes in once, as it scrolls into view, and those that
  // arrive together come one after the other (ADR 28): a sentence never moves
  // out of sight. Only for a visitor who has not asked for less motion, and
  // only with this script: otherwise the list is simply there.
  const list = document.querySelector<HTMLElement>('[data-reveal]');
  if (list && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    list.classList.add('is-armed');
    const observer = new IntersectionObserver(
      (entries) => {
        let rank = 0;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const item = entry.target as HTMLElement;
          item.dataset.rank = String(Math.min(rank++, 4));
          item.classList.add('is-in');
          observer.unobserve(item);
        }
      },
      { threshold: 0.4 },
    );
    for (const item of list.children) observer.observe(item);
  }
</script>
