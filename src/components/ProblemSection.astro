---
import type { ResumeContent } from '../content/index.ts';
import { pathOf } from '../routes.ts';
import { DEFAULT_LOCALE, LOCALE_TAG, type Locale } from '../site.ts';

interface Props {
  locale: Locale;
  t: ResumeContent;
  num: string;
}

const { locale, t, num } = Astro.props;

/** The page of an Offer in this locale, or its French page if it has no other. */
function offerPage(id: Parameters<typeof pathOf>[0]) {
  const here = pathOf(id, locale);
  return {
    href: here ?? pathOf(id, DEFAULT_LOCALE),
    hreflang: here ? undefined : LOCALE_TAG[DEFAULT_LOCALE],
  };
}

const audit = offerPage('audit');
---

<section id="problem" class="problem container">
  <p class="kicker"><span class="kicker__num">{num}</span>{t.problem.kicker}</p>
  <h2 class="section-title problem__title">{t.problem.title}</h2>

  <div class="problem__grid">
    <div class="problem__prose">
      {t.problem.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div>
      <ul class="problem__modes">
        {
          t.failureModes.map((mode, i) => {
            const target = offerPage(mode.offer);
            return (
              <li class="problem__mode">
                <span class="problem__mode-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  {/* The client's sentence is the heading, and it is the way
                      in: it links to the Offer that treats it. A reader who
                      recognises his own words has qualified himself, and now
                      has somewhere to go — see docs/adr/0012 and 0014. */}
                  <h3 class="problem__mode-quote">
                    <a
                      href={target.href}
                      hreflang={target.hreflang}
                    >
                      {mode.quote}
                      <span class="problem__mode-offer">
                        {t.offers[mode.offer].name}
                        {target.hreflang && ` ${t.offersSection.inFrench}`}
                        <span aria-hidden="true"> →</span>
                      </span>
                    </a>
                  </h3>
                  <p class="problem__mode-text">{mode.text}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
      <p class="problem__audit">
        {t.problem.audit.text}{' '}
        <a class="btn btn-secondary" href={audit.href}>{t.problem.audit.cta}</a>
      </p>
    </div>
  </div>
</section>
