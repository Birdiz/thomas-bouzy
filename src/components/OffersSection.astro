---
import type { ResumeContent } from '../content/index.ts';
import { ENTRY_OFFER, OFFER_IDS } from '../content/offers.ts';
import { fromLine } from '../lib/offer-price.ts';
import { linkTo } from '../routes.ts';
import { LOCALE_TAG, type Locale } from '../site.ts';

interface Props {
  locale: Locale;
  t: ResumeContent;
  num: string;
}

const { locale, t, num } = Astro.props;

/**
 * One card per Offer: its plain line, its lowest prices from the price table,
 * and its page. An Offer with no page in this locale links to the French one
 * and says so — the Takeover is French only (ADR 15), and its card is here in
 * English too because the home page sells them all.
 */
const cards = OFFER_IDS.map((id) => ({
  id,
  ...t.offers[id],
  ...linkTo(id, locale),
  from: fromLine(id, locale, t),
  entry: id === ENTRY_OFFER,
}));

const partners = linkTo('partners', locale);
---

<section id="offers" class="offers container">
  <p class="kicker"><span class="kicker__num">{num}</span>{t.offersSection.kicker}</p>
  <h2 class="section-title">{t.offersSection.title}</h2>

  <ul class="offers__grid">
    {
      cards.map((card) => (
        <li class="offers__card" data-offer={card.id}>
          {/* Cards of equal weight did not say where to start (ADR 20). */}
          {card.entry && <p class="offers__badge">{t.offersSection.start}</p>}
          <h3 class="offers__name">
            <a href={card.href} hreflang={card.hreflang && LOCALE_TAG[card.hreflang]}>
              {card.name}
            </a>
          </h3>
          <p class="offers__plain">{card.plain}</p>
          <p class="offers__from">{card.from}</p>
          {/* The name is the link, and it covers the card: identical
              "See the offer" anchors told a search engine nothing (ADR 18). */}
          <span class="offers__link" aria-hidden="true">
            {t.offersSection.see}
            {card.hreflang && ` ${t.offersSection.inFrench}`} →
          </span>
        </li>
      ))
    }
  </ul>

  <p class="offers__partners">
    {t.offersSection.partners}{' '}
    <a href={partners.href} hreflang={partners.hreflang && LOCALE_TAG[partners.hreflang]}>
      {t.offersSection.partnersLink}
    </a>
  </p>
</section>
