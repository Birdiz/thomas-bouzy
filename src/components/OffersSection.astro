---
import { OFFER_VISUAL_VIEWBOX, OFFER_VISUALS } from '../art/offers.ts';
import type { ResumeContent } from '../content/index.ts';
import { ENTRY_OFFER, type OfferId, SITUATIONS } from '../content/offers.ts';
import { fromLine } from '../lib/offer-price.ts';
import { linkTo } from '../routes.ts';
import { LOCALE_TAG, type Locale } from '../site.ts';

interface Props {
  locale: Locale;
  t: ResumeContent;
}

const { locale, t } = Astro.props;

/**
 * One card per Offer: its plain line, its lowest prices from the price table,
 * and its page. An Offer with no page in this locale links to the French one
 * and says so — the Takeover is French only, and its card is here in English
 * too because the home page sells them all.
 */
const card = (id: OfferId) => ({
  id,
  ...t.offers[id],
  ...linkTo(id, locale),
  from: fromLine(id, locale, t),
  entry: id === ENTRY_OFFER,
  visual: OFFER_VISUALS[id],
});

/**
 * The Offers grouped by a situation the reader recognises (ADR 30), each
 * opening on the Client sentences of its Offers (ADR 31): the sentences used
 * to be a section of their own above, which sorted the reader once, and the
 * situations sorted them again. A sentence goes to the situation of the Offer
 * that treats it; the missing tool's owner speaks in the situation's own words.
 * The sentences are read, not clicked (ADR 32): each used to link to an Offer
 * drawn right beside it, two links to one page side by side.
 */
const situations = SITUATIONS.map((ids, i) => {
  const situation = t.offersSection.situations[i];
  const offers: readonly OfferId[] = ids;
  const sentences = t.failureModes
    .filter((mode) => offers.includes(mode.offer))
    .map((mode) => mode.quote);
  if (situation && 'sentence' in situation) sentences.push(situation.sentence);
  return {
    title: situation?.title,
    lead: situation && 'lead' in situation ? situation.lead : undefined,
    sentences,
    cards: ids.map(card),
    team: i === SITUATIONS.length - 1,
  };
});

const partners = linkTo('partners', locale);
const publicSector = linkTo('public-sector', locale);
---

<section id="offers" class="offers container">
  <p class="kicker">{t.offersSection.kicker}</p>
  <h2 class="section-title offers__title">{t.offersSection.title}</h2>
  {/* The question the sentences answer: read under it, they are questions to
      the reader, not testimonials (ADR 28). */}
  <p class="offers__question">{t.offersSection.question}</p>

  {
    situations.map((situation) => (
      <div class="situation">
        <div class="situation__head">
          <h3 class="situation__title">{situation.title}</h3>
          {situation.lead && <p class="situation__lead">{situation.lead}</p>}
          <ul class="situation__sentences" data-reveal>
            {/* A reader who recognises their own words has qualified
                themselves; the Offer that treats them is the row beside. */}
            {situation.sentences.map((quote) => (
              <li class="situation__sentence">{quote}</li>
            ))}
          </ul>
        </div>
        <ul class="situation__cards">
          {situation.cards.map((c) => (
            <li class:list={['offers__card', { 'offers__card--entry': c.entry }]} data-offer={c.id}>
              {/* What the Offer sells, drawn (ADR 32): it tells seven rows
                  apart before a word is read. */}
              <svg
                class="offer-visual"
                viewBox={OFFER_VISUAL_VIEWBOX}
                aria-hidden="true"
                focusable="false"
                set:html={c.visual}
              />
              <div class="offers__body">
                {c.entry && <p class="offers__badge">{t.offersSection.start}</p>}
                {/* The name is the link, and it covers the card: identical "See
                    the offer" anchors told a search engine nothing. The line at
                    the foot says it to the eye, its arrow drawn at rest: on a
                    phone, nothing said the card could be opened (ADR 30). */}
                <h4 class="offers__name">
                  <a href={c.href} hreflang={c.hreflang && LOCALE_TAG[c.hreflang]}>
                    {c.name}
                  </a>
                </h4>
                <p class="offers__plain">{c.plain}</p>
                <div class="offers__foot">
                  <p class="offers__from">{c.from}</p>
                  <p class="offers__more">
                    <span aria-hidden="true">{t.offersSection.more}</span>
                    {c.hreflang && ` ${t.offersSection.inFrench}`}
                    <span class="offers__arrow" aria-hidden="true">→</span>
                  </p>
                </div>
              </div>
            </li>
          ))}
        </ul>
        {/* The Partners, who bring Thomas to a team, under the technical
            team's Offers (ADR 30). */}
        {situation.team && (
          <p class="offers__partners">
            {t.offersSection.partners}{' '}
            <a href={partners.href} hreflang={partners.hreflang && LOCALE_TAG[partners.hreflang]}>
              {t.offersSection.partnersLink}
            </a>
          </p>
        )}
      </div>
    ))
  }

  <p class="offers__partners">
    {t.offersSection.publicSector}{' '}
    <a
      href={publicSector.href}
      hreflang={publicSector.hreflang && LOCALE_TAG[publicSector.hreflang]}
    >
      {t.offersSection.publicSectorLink}
    </a>
  </p>
</section>

<script>
  // Each sentence comes in once, as it scrolls into view, and those that
  // arrive together come one after the other (ADR 28): a sentence never moves
  // out of sight. Only for a visitor who has not asked for less motion, and
  // only with this script: otherwise the lists are simply there.
  const lists = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (lists.length && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        let rank = 0;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const item = entry.target as HTMLElement;
          item.dataset.rank = String(Math.min(rank++, 4));
          item.classList.add('is-in');
          observer.unobserve(item);
        }
      },
      { threshold: 0.4 },
    );
    for (const list of lists) {
      list.classList.add('is-armed');
      for (const item of list.children) observer.observe(item);
    }
  }
</script>
