---
import type { ResumeContent } from '../content/index.ts';
import { CONTACT, type Locale, serviceAreaTowns } from '../site.ts';
import RevealPhone from './RevealPhone.astro';

interface Props {
  locale: Locale;
  t: ResumeContent;
}

const { locale, t } = Astro.props;
---

<section id="contact" class="contact container">
  <div class="contact__panel">
    <div class="contact__blob" aria-hidden="true"></div>
    <div class="contact__body">
      <p class="kicker">{t.contact.kicker}</p>
      <h2 class="contact__title">{t.contact.title}</h2>
      <p class="contact__blurb">{t.contact.blurb}</p>

      {/* One primary action, the call: it is what the whole page asks for.
          A plain outbound link, never an embed. The other ways in are links,
          one line under it, so they do not compete with it. */}
      <div class="contact__actions">
        <a class="btn btn-primary" href={CONTACT.booking} target="_blank" rel="noopener">
          {t.contact.cta}
        </a>
      </div>
      <p class="contact__others">
        <span>{t.contact.orReach}</span>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <RevealPhone locale={locale} label={t.contact.revealPhone} buttonClass="contact__link" />
        <a href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </p>

      {/* The Service area, so that the home page names the towns a local
          Client searches with, and not only the Offer pages (ADR 20). */}
      <p class="contact__location">
        {t.contact.locationLine.replace('{towns}', serviceAreaTowns(locale))}
      </p>
    </div>

    {/* Who answers the call, beside the call itself: About used to be a
        section of its own, one more between the Offers and Contact. */}
    <div id="about" class="contact__about">
      <p class="kicker">{t.about.kicker}</p>
      <h3 class="contact__about-title">{t.about.title}</h3>
      {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      {/* The salaried route, named once and at the end, and pointed at
          LinkedIn, which carries the career. */}
      <p class="about__career">
        {t.about.careerLine}{' '}
        <a href={CONTACT.linkedin} target="_blank" rel="noopener">{t.about.careerLink}</a>
      </p>
    </div>
  </div>
</section>
