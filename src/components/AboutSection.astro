---
import type { ResumeContent } from '../content/index.ts';

interface Props {
  t: ResumeContent;
}

const { t } = Astro.props;
---

<section id="about" class="about container">
  <div class="about__grid">
    <div class="about__prose">
      <p class="kicker">{t.about.kicker}</p>
      <h2 class="section-title">{t.about.title}</h2>
      {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="about__aside">
      <div class="card mentoring">
        <h3 class="card-kicker">{t.about.mentoringKicker}</h3>
        <ul class="mentoring__list">
          {
            t.mentoring.map((entry) => (
              <li class="mentoring__row">
                <span class="mentoring__year">{entry.year}</span>
                <span class="mentoring__text">{entry.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="about__pair">
        <div class="card">
          <h3 class="card-kicker">{t.about.languagesKicker}</h3>
          <ul class="langs">
            {
              t.languages.map((language) => (
                <li>
                  <strong>{language.name}</strong> <span>{language.level}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card">
          <h3 class="card-kicker">{t.about.educationKicker}</h3>
          <p class="education">{t.about.educationText}</p>
        </div>
      </div>
    </div>
  </div>
</section>
