---
import type { ResumeContent } from '../content/index.ts';

interface Props {
  t: ResumeContent;
}

const { t } = Astro.props;
---

<section id="skills" class="skills container">
  <p class="kicker">{t.skillsSection.kicker}</p>
  <h2 class="section-title">{t.skillsSection.title}</h2>

  <ul class="skills__grid">
    {
      t.skills.map((group) => (
        <li class="card elev-sm skills__group">
          <h3 class="skills__name">
            <span class="skills__dot" aria-hidden="true" />
            {group.name}
          </h3>
          <ul class="skills__items">
            {group.items.map((item) => (
              <li class="tag tag-neutral">{item}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
