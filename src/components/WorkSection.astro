---
import type { ResumeContent } from '../content/index.ts';

interface Props {
  t: ResumeContent;
  num: string;
}

const { t, num } = Astro.props;
---

<section id="work" class="work container">
  <p class="kicker"><span class="kicker__num">{num}</span>{t.work.kicker}</p>
  <h2 class="section-title">{t.work.title}</h2>
  <p class="work__intro">{t.work.intro}</p>

  <div class="work__list">
    {
      t.achievements.map((achievement, index) => (
        /* `name` makes the browser enforce one-open-at-a-time. That was three
           lines of component state in the design; here it costs no JavaScript
           and comes with correct aria-expanded for free. */
        <details class="achievement" name="achievements" open={index === 0}>
          <summary class="achievement__summary">
            <span class="achievement__num" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="achievement__heading">
              <span class="achievement__title">{achievement.title}</span>
              <span class="achievement__meta">
                <span>{achievement.org}</span>
                <span aria-hidden="true">·</span>
                <span>{achievement.period}</span>
              </span>
            </h3>
            <span class="achievement__chevron" aria-hidden="true">↓</span>
          </summary>

          <div class="achievement__panel">
            <div class="achievement__rule" aria-hidden="true" />
            {/* Thomas's own rule, applied to every card rather than to one:
                say what the work was before using a word anyone has to learn.
                The label carries its own colon because French spaces it. */}
            <p class="achievement__plain">
              <span class="achievement__plain-label">{t.work.labelPlain}</span>{' '}
              {achievement.plain}
            </p>
            <div class="achievement__facets">
              <div class="achievement__facet">
                <p class="kicker achievement__facet-label">{t.work.labelContext}</p>
                <p class="achievement__facet-text">{achievement.context}</p>
              </div>
              <div class="achievement__facet">
                <p class="kicker achievement__facet-label">{t.work.labelApproach}</p>
                <p class="achievement__facet-text">{achievement.approach}</p>
              </div>
              <div class="achievement__facet">
                <p class="kicker achievement__facet-label">{t.work.labelResult}</p>
                <p class="achievement__facet-text">{achievement.result}</p>
              </div>
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>
