---
import type { ResumeContent } from '../content/index.ts';
import { breadcrumbOf } from '../lib/breadcrumb.ts';
import type { Route } from '../routes.ts';

interface Props {
  route: Route;
  t: ResumeContent;
}

const { route, t } = Astro.props;

/* Every page but the home page says where it sits, in the kicker's place:
   reaching the Offers from an Offer used to mean going through the menu. The
   JSON-LD's BreadcrumbList reads the same trail. */
const steps = breadcrumbOf(route);
const current = steps.pop();
---

<nav class="kicker breadcrumb" aria-label={t.a11y.breadcrumb}>
  <ol class="breadcrumb__list">
    {
      steps.map((step) => (
        <li>
          <a href={step.href}>{step.name}</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
        </li>
      ))
    }
    <li aria-current="page">{current?.name}</li>
  </ol>
</nav>
